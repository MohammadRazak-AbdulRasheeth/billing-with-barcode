{
  "name": "barcode-product-management",
  "version": "1.0.0",
  "description": "Single-Shop POS Billing & Mobile Barcode Scanning System",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/src/index.ts",
    "client:dev": "cd client && npm run dev -- --host",
    "postinstall": "cd client && npm install",
    "build": "cd client && npm install && npm run build",
    "start": "node server.js",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "prisma:studio": "npx prisma studio"
  },
  "keywords": ["pos", "barcode", "billing", "inventory", "mysql", "prisma", "socketio"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
