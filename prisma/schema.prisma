datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Products & Inventory
model Product {
  id                 Int             @id @default(autoincrement())
  sku                String          @unique @db.VarChar(100)
  barcode            String          @unique @db.VarChar(100)
  name               String          @db.VarChar(255)
  category           String?         @db.VarChar(100)
  costPrice          Decimal         @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  sellingPrice       Decimal         @map("selling_price") @db.Decimal(10, 2)
  taxRate            Decimal         @default(0.00) @map("tax_rate") @db.Decimal(5, 2) // e.g. 5.00%, 18.00%
  stockQuantity      Int             @default(0) @map("stock_quantity")
  lowStockThreshold  Int             @default(5) @map("low_stock_threshold")
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  invoiceItems       InvoiceItem[]
  inventoryLogs      InventoryLog[]

  @@map("products")
}

// 2. Invoices (Completed Sales)
model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(100) // e.g. INV-20261019-001
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentMethod  String        @map("payment_method") @db.VarChar(50) // CASH, UPI, CARD, OTHER
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")

  items          InvoiceItem[]

  @@map("invoices")
}

// 3. Invoice Line Items
model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  productId   Int?     @map("product_id")
  productName String   @map("product_name") @db.VarChar(255)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  costPrice   Decimal  @map("cost_price") @db.Decimal(10, 2)
  quantity    Int
  discount    Decimal  @default(0.00) @db.Decimal(10, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(10, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

// 4. Stock Movement Audit Trail
model InventoryLog {
  id             Int         @id @default(autoincrement())
  productId      Int         @map("product_id")
  changeQuantity Int         @map("change_quantity") // Positive for restock, negative for sales
  reason         String      @db.VarChar(50) // SALE, RESTOCK, DAMAGE, CORRECTION
  referenceId    String?     @map("reference_id") @db.VarChar(100) // e.g. invoice_number
  createdAt      DateTime    @default(now()) @map("created_at")

  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("inventory_logs")
}

// 5. Shop & Receipt Settings
model Setting {
  key       String   @id @db.VarChar(100) // 'SHOP_NAME', 'SHOP_ADDRESS', 'SHOP_GST', 'RECEIPT_FOOTER', 'CURRENCY', etc.
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
